{
  "manifest_version": 3,
  "name": "치지직 이모티콘 단축키",
  "version": "0.1.0",
  "description": "Alt/Option + 숫자로 등록한 치지직 이모티콘을 채팅 입력창에 넣습니다.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chzzk.naver.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "치지직 이모티콘 단축키" }
}
