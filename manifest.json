{
  "manifest_version": 3,
  "name": "치지직 이모티콘 단축키",
  "version": "0.2.0",
  "description": "치지직 이모티콘에 원하는 단축키를 지정하고, 즐겨찾기·세트·JSON 백업으로 관리합니다.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "core.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "치지직 이모티콘 단축키"
  }
}
